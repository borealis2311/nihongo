    "word": {
      "type": "string",
      "required": true
    },
    "hiragana": {
      "type": "string"
    },
    "katakana": {
      "type": "string"
    },
    "romaji": {
      "type": "string"
    },
    "sentence": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "lesson": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::lesson.lesson",
      "inversedBy": "words"
    }
  }
}
