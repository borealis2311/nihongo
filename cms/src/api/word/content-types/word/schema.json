{
  "kind": "collectionType",
  "collectionName": "words",
  "info": {
    "singularName": "word",
    "pluralName": "words",
    "displayName": "Word",
    "description": "Từ vựng - thuộc 1 Bài học"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
