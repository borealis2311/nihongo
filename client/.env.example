# URL Strapi mà trình duyệt (client) gọi tới để đọc dữ liệu công khai.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# URL Strapi mà server Next.js (route handlers) dùng để gọi API ghi dữ liệu.
# Thường trùng NEXT_PUBLIC_STRAPI_URL, tách riêng để phòng khi deploy khác domain nội bộ/công khai.
STRAPI_URL=http://localhost:1337

# API Token tạo trong Strapi Admin > Settings > API Tokens (quyền Create trên collection "Word").
# KHÔNG bao giờ thêm tiền tố NEXT_PUBLIC_ cho biến này vì nó chỉ được dùng ở route handler (server).
STRAPI_API_TOKEN=

# API key OpenAI, dùng ở server để gọi GPT-4o trích xuất từ vựng từ ảnh.
OPENAI_API_KEY=
