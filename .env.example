# Biến cho docker-compose.yml (copy thành .env ở thư mục gốc).
# Biến riêng của từng app vẫn nằm ở client/.env và cms/.env.

# URL công khai của Strapi mà trình duyệt truy cập (nhúng vào client lúc build).
PUBLIC_STRAPI_URL=http://localhost:1337

# ---- n8n ----
N8N_VERSION=latest
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
# Tạo bằng: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Đặt true khi chạy sau HTTPS.
N8N_SECURE_COOKIE=false
TZ=Asia/Ho_Chi_Minh

# ---- Cổng public ra máy host (đổi nếu bị trùng) ----
CMS_PORT=1337
CLIENT_PORT=3000
N8N_PORT=5678
